<% @page_title = 'Browse Auctions' %>

<section class="browse">
    <h2>🔍 Browse Auctions</h2>
    
    <% if @auctions.any? %>
        <h3>Live Auctions</h3>
        <div class="auction-grid">
            <% @auctions.each do |auction| %>
                <article class="auction-card">
                    <div class="auction-card-header">
                        <span class="badge <%= status_badge_class(auction[:status]) %>"><%= auction[:status] %></span>
                        <span class="badge badge-secondary"><%= auction[:category] %></span>
                    </div>
                    <h4 class="auction-card-title"><%= auction[:title] %></h4>
                    <div class="auction-card-meta">
                        <span class="price"><%= format_currency(auction[:current_bid_cents] > 0 ? auction[:current_bid_cents] : auction[:starting_price_cents]) %></span>
                        <span class="bids"><%= auction[:bid_count] %> bid<%= auction[:bid_count] == 1 ? '' : 's' %></span>
                    </div>
                    <div class="auction-card-footer">
                        <span class="seller">by <%= auction[:seller_name] %></span>
                        <a href="/browse/<%= auction[:product_id] %>" class="btn btn-primary btn-sm">View</a>
                    </div>
                </article>
            <% end %>
        </div>
    <% end %>
    
    <% if @ended.any? %>
        <h3 class="mt-4">Recently Ended</h3>
        <div class="auction-grid">
            <% @ended.each do |auction| %>
                <article class="auction-card ended">
                    <div class="auction-card-header">
                        <span class="badge badge-secondary">ended</span>
                        <span class="badge badge-secondary"><%= auction[:category] %></span>
                    </div>
                    <h4 class="auction-card-title"><%= auction[:title] %></h4>
                    <div class="auction-card-meta">
                        <span class="price"><%= format_currency(auction[:current_bid_cents] > 0 ? auction[:current_bid_cents] : auction[:starting_price_cents]) %></span>
                        <span class="bids"><%= auction[:bid_count] %> bid<%= auction[:bid_count] == 1 ? '' : 's' %></span>
                    </div>
                    <div class="auction-card-footer">
                        <span class="seller">by <%= auction[:seller_name] %></span>
                    </div>
                </article>
            <% end %>
        </div>
    <% end %>
    
    <% if @auctions.empty? && @ended.empty? %>
        <div class="card empty-state">
            <p>📦 No auctions available</p>
        </div>
    <% end %>
</section>
