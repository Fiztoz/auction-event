<% @page_title = @auction[:title] %>

<section class="auction-detail">
    <a href="/browse" class="back-link">← Back to Browse</a>
    
    <div class="detail-header">
        <div class="detail-badges">
            <span class="badge <%= status_badge_class(@auction[:status]) %>"><%= @auction[:status] %></span>
            <span class="badge badge-secondary"><%= @auction[:category] %></span>
        </div>
        <h1><%= @auction[:title] %></h1>
    </div>
    
    <div class="detail-content">
        <div class="detail-main">
            <div class="detail-price">
                <span class="label">Current Bid</span>
                <span class="value"><%= format_currency(@auction[:current_bid_cents] > 0 ? @auction[:current_bid_cents] : @auction[:starting_price_cents]) %></span>
            </div>
            
            <div class="detail-stats">
                <div class="stat">
                    <span class="label">Starting Price</span>
                    <span class="value"><%= format_currency(@auction[:starting_price_cents]) %></span>
                </div>
                <div class="stat">
                    <span class="label">Total Bids</span>
                    <span class="value"><%= @auction[:bid_count] %></span>
                </div>
                <div class="stat">
                    <span class="label">Ends At</span>
                    <span class="value"><%= format_date(@auction[:ends_at]) %></span>
                </div>
            </div>
            
            <% if @auction[:description] %>
                <div class="detail-description">
                    <h3>Description</h3>
                    <p><%= @auction[:description] %></p>
                </div>
            <% end %>
        </div>
        
        <div class="detail-sidebar">
            <div class="seller-card">
                <h3>Seller</h3>
                <p class="seller-name"><%= @auction[:seller_name] %></p>
            </div>
        </div>
    </div>
</section>
