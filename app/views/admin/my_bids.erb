<% @page_title = 'My Bids' %>

<div class="page-header">
    <div>
        <h1 class="page-title">My Bids</h1>
        <p class="page-subtitle">Auctions you have bid on</p>
    </div>
    <div class="page-actions">
        <div class="dashboard-controls">
            <span id="connection-status" class="connection-status connected" title="Real-time updates active"></span>
            <span id="last-updated" class="last-updated">Last updated: just now</span>
        </div>
    </div>
</div>

<!-- Compact inline search bar -->
<form action="/admin/my-bids" method="get">
    <div class="search-bar">
        <div class="form-group">
            <label class="form-label">Buyer ID</label>
            <input type="text" name="buyer_id" class="form-control" placeholder="e.g. buyer-001" value="<%= params[:buyer_id] %>">
        </div>
        <button type="submit" class="btn btn-primary">View Bids</button>
    </div>
</form>

<% if params[:buyer_id] && !params[:buyer_id].empty? %>
    <% if @bids.empty? %>
        <div class="card">
            <div class="card-body">
                <div class="empty-state">
                    <div class="empty-state-icon">🔨</div>
                    <h3 class="empty-state-title">No bid activity found</h3>
                    <p class="empty-state-text">This buyer hasn't placed any bids yet.</p>
                    <div class="mt-4">
                        <span class="badge badge-secondary">Buyer: <%= params[:buyer_id] %></span>
                    </div>
                </div>
            </div>
        </div>
    <% else %>
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Bid History (<%= @bids.length %>)</h2>
                <span class="badge badge-secondary">Buyer: <%= params[:buyer_id] %></span>
            </div>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Seller</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody id="bids-list">
                        <% @bids.each do |bid| %>
                            <tr>
                                <td>
                                    <div class="font-medium"><%= bid[:product_title] %></div>
                                </td>
                                <td><%= bid[:seller_name] %></td>
                                <td class="font-semibold"><%= format_currency(bid[:amount_cents]) %></td>
                                <td>
                                    <span class="badge <%= status_badge_class(bid[:status]) %>">
                                        <%= bid[:status].capitalize %>
                                    </span>
                                </td>
                                <td class="text-muted"><%= time_ago(bid[:created_at]) %></td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
            <!-- Mobile card layout -->
            <div class="data-card-list">
                <% @bids.each do |bid| %>
                    <div class="data-card">
                        <div class="data-card-title"><%= bid[:product_title] %></div>
                        <div class="data-card-row">
                            <span class="data-card-label">Seller</span>
                            <span class="data-card-value"><%= bid[:seller_name] %></span>
                        </div>
                        <div class="data-card-row">
                            <span class="data-card-label">Amount</span>
                            <span class="data-card-value font-semibold"><%= format_currency(bid[:amount_cents]) %></span>
                        </div>
                        <div class="data-card-row">
                            <span class="data-card-label">Status</span>
                            <span class="data-card-value"><span class="badge <%= status_badge_class(bid[:status]) %>"><%= bid[:status].capitalize %></span></span>
                        </div>
                        <div class="data-card-row">
                            <span class="data-card-label">Date</span>
                            <span class="data-card-value text-muted"><%= time_ago(bid[:created_at]) %></span>
                        </div>
                    </div>
                <% end %>
            </div>
        </div>
    <% end %>
<% else %>
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <div class="empty-state-icon">🔍</div>
                <h3 class="empty-state-title">Enter a Buyer ID</h3>
                <p class="empty-state-text">Enter a buyer ID above and click "View Bids" to see their bidding history.</p>
            </div>
        </div>
    </div>
<% end %>

<script src="/js/sse.js"></script>
