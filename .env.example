MONGO_URL=mongodb://localhost:27017
MONGO_DB=basic4_onboarding
SESSION_SECRET=change-me-to-a-long-random-string-at-least-sixty-four-characters-long
PORT=4567
RACK_ENV=development

# Product images are stored in MinIO (S3-compatible object storage).
# For local `rackup` dev, run just MinIO with: docker compose up minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=basic4-products

# When running via docker-compose, only SESSION_SECRET and PORT are read from .env;
# MONGO_URL is overridden to point at the `mongo` service, and MINIO_ENDPOINT to
# the `minio` service (MINIO_PUBLIC_URL stays host-facing for browser image URLs).
