#!/usr/bin/env ruby
require_relative "../lib/basic4"

input, output = ARGV
abort "Usage: basic4-report <input.csv> <output.txt>" unless input && output

begin
  Basic4.report(input, output)
  puts "Wrote report to #{output}"
rescue Basic4::ReportError, Errno::ENOENT, Errno::EACCES => e
  warn "error: #{e.message}"
  exit 1
end
