#!/usr/bin/env ruby
# Seeds (or promotes) a back-office admin. Admins are never created through
# signup — run this once to bootstrap one, then sign in at /app as usual.
#
#   ADMIN_EMAIL=ops@basic4.test ADMIN_PASSWORD=supersecret bin/create_admin
#   bin/create_admin ops@basic4.test supersecret "Ops Team"
#
# Idempotent: re-running with an existing email promotes that user to admin
# (leaving their password untouched) instead of failing.

require_relative "../app"

email    = (ENV["ADMIN_EMAIL"]    || ARGV[0]).to_s.strip.downcase
password = (ENV["ADMIN_PASSWORD"] || ARGV[1]).to_s
name     = (ENV["ADMIN_NAME"]     || ARGV[2] || "Admin").to_s.strip

abort "email required (ADMIN_EMAIL or first arg)" if email.empty?
abort "invalid email: #{email}" unless email.match?(Basic4::User::EMAIL_REGEX)

container = Basic4::Container.production
repo      = container[:user_repository]
clock     = container[:clock]

existing = repo.find_by_email(email)
if existing
  if existing.role == "admin"
    puts "#{email} is already an admin — nothing to do."
  else
    repo.store(existing.with(role: "admin", updated_at: clock.now))
    puts "Promoted #{email} to admin."
  end
  exit 0
end

min = Basic4::User::MIN_PASSWORD_LENGTH
abort "password must be #{min}+ chars (ADMIN_PASSWORD or second arg)" if password.length < min

admin = Basic4::User.create_admin(
  id:            container[:tokens].user_id,
  email:         email,
  name:          name.empty? ? "Admin" : name,
  password_hash: container[:password_hasher].hash(password),
  at:            clock.now
)
repo.store(admin)
puts "Created admin #{email}. Sign in at /app, then open /admin."
